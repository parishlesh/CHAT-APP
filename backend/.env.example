MONGO_URI=your_mongodb_connection_string
PORT=5001
JWT_SECRET=your_jwt_secret
OTP_SECRET=your_otp_hmac_secret
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Use none only if the browser must call the API on a different site (not recommended).
# COOKIE_SAMESITE=none
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
# Render (and similar hosts) block outbound SMTP. Use Brevo's HTTPS API there.
# Create an API key in Brevo → SMTP & API → API keys (xkeysib-...), not the SMTP login.
BREVO_API_KEY=
