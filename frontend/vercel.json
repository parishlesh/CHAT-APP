{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://chat-app-backend-tjz8.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io",
      "destination": "https://chat-app-backend-tjz8.onrender.com/socket.io"
    },
    {
      "source": "/socket.io/",
      "destination": "https://chat-app-backend-tjz8.onrender.com/socket.io/"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://chat-app-backend-tjz8.onrender.com/socket.io/:path*"
    },
    {
      "source": "/((?!api/|socket.io/).*)",
      "destination": "/index.html"
    }
  ]
}
